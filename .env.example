# Пример переменных окружения сборки.
# Скопируйте в .env для локальной разработки. НЕ коммитьте реальный .env.
#
# Все значения ниже — ПУБЛИЧНЫЕ (они попадают в JS-бандл SPA). Секреты
# (SSH-ключи деплоя и т.п.) сюда НЕ кладём — они живут только в GitHub Secrets.

# --- Идентификаторы портала (переопределяют runtimeConfig.public) ---
# По умолчанию берутся из nuxt.config.ts; переопределяйте при сборке под другой портал.

# Смарт-процесс «Оплаты»
NUXT_PUBLIC_SMART_PROCESS_ID_PAYMENT=1036
# Категория сделок «в работу»
NUXT_PUBLIC_DEAL_FOR_WORK_CATEGORY_ID=2
# Категория сделок «Подрядчики» (расходные распределения, issue aida#121)
NUXT_PUBLIC_DEAL_FOR_CONTRACTOR_CATEGORY_ID=3
# Смарт-процесс «Распределения»
NUXT_PUBLIC_SMART_PROCESS_ID_DISTRIBUTIONS=1044
# Статус «успешно закрыта»
NUXT_PUBLIC_SMART_PROCESS_STATUS_PAYMENT_SUCCESS=DT1036_14:SUCCESS
# Статус «забракована»
NUXT_PUBLIC_SMART_PROCESS_STATUS_PAYMENT_FAIL=DT1036_14:FAIL
# ID платёжной системы «перевод» (иконка MailMoney; иначе — счёт)
NUXT_PUBLIC_PAY_SYSTEM_ID_MAIL_MONEY=9

# --- Dev ---
# Разрешённые хосты для dev-сервера (тоннели ngrok/cloudpub), через запятую.
# NUXT_ALLOWED_HOSTS=example.ngrok-free.app

# --- Деплой (только справочно; задаётся в GitHub Secrets, НЕ здесь) ---
# SSH_DEPLOY_KEY    — приватный ключ ED25519
# SSH_KNOWN_HOSTS   — вывод ssh-keyscan <хост сервера>
# SSH_DEPLOY_USER   — <ssh-пользователь>
# SSH_DEPLOY_HOST   — <хост сервера>
# SSH_DEPLOY_PATH   — <путь к каталогу публикации на сервере>
